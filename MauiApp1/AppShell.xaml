<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    BackgroundColor="Black"
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="MauiApp1">

    <TabBar>
        <ShellContent Title="Начало" ContentTemplate="{DataTemplate local:HomePage}" />
        <ShellContent Title="Тренировки" ContentTemplate="{DataTemplate local:WorkoutsPage}" />
        <ShellContent Title="Статистика" ContentTemplate="{DataTemplate local:StatsPage}" />
    </TabBar>
</Shell>
